# ============================================================
#  Santé Infantile Bénin — Variables d'environnement
#  Copiez ce fichier en `.env` et remplissez vos valeurs.
#  (Le fichier `.env` est ignoré par Git — ne le committez pas.)
# ============================================================

# --- Django ---
SECRET_KEY=changez-moi-par-une-longue-cle-aleatoire
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# --- Base de données (Render fournit cette variable automatiquement) ---
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# --- IA de triage (Groq) ---
GROQ_API_KEY=votre-cle-groq
GROQ_MODEL=llama-3.3-70b-versatile

# --- SMS / OTP (Twilio — optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
